# Run from the project root in Bash: source configs/sv_fca_tables_1_8.env.example
# Relative paths below are resolved from the project root by every sh script.
export PY=python3
export DATA_DIR="../datasets/imagenet/val"
export LABELS_CSV="../datasets/imagenet/imagenet_val_labels.csv"
# For ImageFolder input, use LABELS_CSV="" and class-subfolder validation data.
export MODEL_DIR="./pretrained_models"
export OUT_DIR="./runs"
export DEVICE=cuda
export BATCH_SIZE=4
export EVAL_BATCH_SIZE=4
export NUM_IMAGES=1000
export NUM_WORKERS=2
export SEED=0
# Optional short run: export NUM_BATCHES=2 (at most 2 x BATCH_SIZE images).
# Omit NUM_IMAGES when you want it inferred from NUM_BATCHES x BATCH_SIZE.
# Set DELETE_ADV_AFTER_USE=0 to retain tensors for later evaluation/figures.
export DELETE_ADV_AFTER_USE=1
export ADV_STORAGE_MODE=delta_fp16

# Final SV-FCA
export SVFCA_NUM_VIEWS=4
export SVFCA_SPECTRAL_BANDS=6
export SVFCA_DIVERSITY_PROB=1.0
export SVFCA_BAND_TEMPERATURE=0.35
export SVFCA_LOW_MID_STRENGTH=1.0
export SVFCA_SPECTRAL_DECAY=0.75
export SVFCA_DECAY=1.0
export SVFCA_AMP=0
export SVFCA_AMP_DTYPE=fp16

# Table VIII: MUST be the parent folder that contains imagenet/Linf/*.pt
export ROBUSTBENCH_MODEL_DIR="./models"
# Skip unavailable local defense weights: export SKIP_TABLE8=1
